{
  "manifest_version": 3,
  "name": "Sergio Brain Capture",
  "version": "0.2.0",
  "description": "Save pages, selections and your AI conversations (ChatGPT, Claude, Gemini) into Boveda Sergio via the local SERGIO BRAIN engine.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "action": { "default_popup": "popup.html", "default_title": "Sergio Brain Capture" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
      "js": ["ai-chat.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {}
}
